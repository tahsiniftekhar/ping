NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/ping
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (required in production)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the server (defaults to 1 in production, 0 otherwise)
# TRUST_PROXY=1
LOG_LEVEL=info
