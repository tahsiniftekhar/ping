# Chat API configuration.
# Copy this file to .env.local and fill in the real values before running.
# Both variables are required — src/lib/env.ts throws if either is missing.

# REST base URL of the chat API (include the /api path).
NEXT_PUBLIC_API_BASE_URL=https://frontend-task-chatapp.onrender.com/api

# Socket.io host root (do NOT include /api). Socket.io serves itself at /socket.io/.
NEXT_PUBLIC_SOCKET_URL=https://frontend-task-chatapp.onrender.com
